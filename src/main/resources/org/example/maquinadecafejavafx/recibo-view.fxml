<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="800.0" prefWidth="1200.0" spacing="16.0" style="-fx-background-color: #f5efe6;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="30" left="40" right="40" top="30" />
    </padding>
   <children>
   
       <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #3c2415;" text="Resumen de tu pedido" />
   
       <Label fx:id="lblCliente" style="-fx-font-size: 14px;" />
       <Label fx:id="lblProducto" style="-fx-font-size: 14px;" />
       <Label fx:id="lblPrecio" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #3c2415;" />
   
       <TextField fx:id="txtValorIngresado" maxWidth="220" promptText="Valor con el que pagas" />
   
       <Label fx:id="lblMensaje" style="-fx-font-size: 12px;" />
   
       <HBox alignment="CENTER" spacing="12">
      <children>
              <Button onAction="#pagar" style="-fx-background-color: #c98a4b; -fx-text-fill: white; -fx-padding: 8 20;" text="Pagar" />
              <Button fx:id="btnContinuar" onAction="#continuar" style="-fx-padding: 8 20;" text="Continuar" />
      </children>
       </HBox>
   </children>
</VBox>
