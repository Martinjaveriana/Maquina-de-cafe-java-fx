<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="800.0" prefWidth="1200.0" spacing="16.0" style="-fx-background-color: #f5efe6;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="30" left="40" right="40" top="30" />
    </padding>
    <children>

        <Label style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #3c2415;" text="Nivel de azucar" />
        <HBox alignment="CENTER" spacing="16" />
        <HBox alignment="CENTER" spacing="16">
            <children>
                <RadioButton fx:id="rbNada" text="Nada">
                    <toggleGroup>
                        <ToggleGroup fx:id="grupoAzucar" />
                    </toggleGroup>
                </RadioButton>
                <RadioButton fx:id="rbBajo" text="Bajo" toggleGroup="$grupoAzucar" />
                <RadioButton fx:id="rbMedio" text="Medio" toggleGroup="$grupoAzucar" />
            <RadioButton fx:id="rbAlto" text="Alto" toggleGroup="$grupoAzucar" />
            </children>
        </HBox>

        <Label fx:id="lblError" style="-fx-text-fill: #b3261e; -fx-font-size: 12px;" />

        <HBox alignment="CENTER" spacing="12">
            <children>
                <Button onAction="#continuar" style="-fx-background-color: #c98a4b; -fx-text-fill: white; -fx-padding: 8 20;" text="Continuar" />
            <Button onAction="#volver" style="-fx-padding: 8 20;" text="Volver" />
            </children>
        </HBox>
    </children>
</VBox>
